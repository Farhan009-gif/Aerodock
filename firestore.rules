rules_version = '2';

// Runway Groups (Phase 1) — paste this into Firebase console →
// Firestore Database → Rules, then Publish. Until then the database is in
// production mode and denies everything, so Groups cannot work.
//
// Layout: users/{uid} · groups/{groupId} (+ messages subcollection) ·
// stats/global · config/admin (console-managed admin uid list).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid in
             get(/databases/$(database)/documents/config/admin).data.get('uids', []);
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    // Profile cards: a user can read/write only their own doc.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Admin list: signed-in users may read it (the app checks membership
    // client-side to show/hide the Admin entry). Nobody can write it from a
    // client — edit it in the Firebase console only.
    match /config/admin {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /stats/global {
      // Counters readable by admins only.
      allow read: if isAdmin();

      // First write creates the doc with a single counter at 1 (the client's
      // set+merge of a FieldValue.increment).
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['totalUsers', 'totalGroups', 'totalMessages'])
        && request.resource.data.get('totalUsers', 0) <= 1
        && request.resource.data.get('totalGroups', 0) <= 1
        && request.resource.data.get('totalMessages', 0) <= 1;

      // Later writes may only bump the known counters, each by exactly +1 —
      // that is what FieldValue.increment(1) looks like to rules.
      // KNOWN SOFTNESS (accepted for Phase 1): any signed-in user could call
      // the API directly and inflate the counters. They are informational
      // only; nothing is gated on them.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['totalUsers', 'totalGroups', 'totalMessages'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalUsers'])
             || request.resource.data.totalUsers == resource.data.get('totalUsers', 0) + 1)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalGroups'])
             || request.resource.data.totalGroups == resource.data.get('totalGroups', 0) + 1)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalMessages'])
             || request.resource.data.totalMessages == resource.data.get('totalMessages', 0) + 1);

      allow delete: if false;
    }

    match /groups/{groupId} {
      // Members only. The matching query (whereArrayContains memberUids)
      // is provable against this rule, so list queries work.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      // Creator must make themselves owner and a member.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      allow update: if isSignedIn() && (
        // (a) A member sent a message: only lastMessageAt + messageCount may
        // change, and the count rises by exactly 1.
        (request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastMessageAt', 'messageCount'])
          && request.resource.data.messageCount == resource.data.get('messageCount', 0) + 1)
        ||
        // (b) Join: the only change is the caller adding exactly themselves —
        // the member list grows by one, keeps every existing member
        // (hasAll), and the caller was not already in it.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && !(request.auth.uid in resource.data.memberUids))
      );

      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        // Sender must be a member and must write as themselves.
        // (senderName is cosmetic and not verified in Phase 1.)
        allow create: if isGroupMember(groupId)
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
